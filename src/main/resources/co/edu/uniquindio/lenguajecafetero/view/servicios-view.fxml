<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="tab-content" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.ServiciosController">

    <VBox spacing="10" styleClass="card">
        <Label text="Registrar servicio adicional" styleClass="card-title"/>
        <Label text="Simulacros, tutorías, material o talleres de conversación" styleClass="card-subtitle"/>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" maxWidth="180"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
            </columnConstraints>
            <Label text="Tipo de servicio" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbTipo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Código" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtCodigo" promptText="Ej. S-EX-01" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtNombre" promptText="Ej. Simulacro de certificación" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Descripción" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtDescripcion" promptText="Breve descripción del servicio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="Precio" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="txtPrecio" promptText="Ej. 55000" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <CheckBox fx:id="chkDisponible" text="Disponible para contratar" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>
        <HBox styleClass="card-actions">
            <Button text="Registrar servicio" onAction="#onRegistrar" styleClass="btn-primary"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Solicitar servicio sobre matrícula" styleClass="card-title"/>
                <Label text="El valor del servicio se suma al pago final de la matrícula" styleClass="card-subtitle"/>
            </VBox>
            <Button text="Refrescar" onAction="#onRefrescar" styleClass="btn-secondary"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Matrícula"/>
                <ComboBox fx:id="cmbMatricula" HBox.hgrow="ALWAYS"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Servicio"/>
                <ComboBox fx:id="cmbServicioSolicitar" HBox.hgrow="ALWAYS"/>
            </VBox>
            <Button text="Solicitar" onAction="#onSolicitar" styleClass="btn-primary"/>
        </HBox>
    </VBox>

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Servicios de la academia" styleClass="card-title"/>
        <ListView fx:id="listaServicios" prefHeight="150" VBox.vgrow="ALWAYS" styleClass="list-view"/>
    </VBox>
</VBox>