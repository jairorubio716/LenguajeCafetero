<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.ReportesController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <VBox spacing="10" styleClass="card">
        <Label text="Ingresos por periodo"/>
        <GridPane hgap="8" vgap="8">
            <Label text="Fecha inicial:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="dpInicio" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Fecha final:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpFin" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <Button text="Consultar" onAction="#onConsultar" styleClass="btn-primary"/>
        <Label fx:id="lblTotal" text="Ingresos del periodo: $0.00"/>
    </VBox>
</VBox>
