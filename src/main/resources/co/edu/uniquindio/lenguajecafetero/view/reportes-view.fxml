<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="tab-content" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.ReportesController">

    <VBox spacing="10" styleClass="card">
        <Label text="Ingresos por periodo" styleClass="card-title"/>
        <Label text="Consulte el valor final de las matrículas entre dos fechas" styleClass="card-subtitle"/>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" maxWidth="180"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
            </columnConstraints>
            <Label text="Fecha inicial" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <DatePicker fx:id="dpInicio" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Fecha final" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpFin" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <HBox styleClass="card-actions">
            <Button text="Consultar ingresos" onAction="#onConsultar" styleClass="btn-primary"/>
        </HBox>
    </VBox>

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Resultado" styleClass="card-title"/>
        <Label fx:id="lblTotal" text="Ingresos del periodo: $0.00" styleClass="report-total"/>
    </VBox>
</VBox>