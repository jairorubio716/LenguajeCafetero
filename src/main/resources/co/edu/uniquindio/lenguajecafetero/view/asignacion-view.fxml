<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="tab-content" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.AsignacionController">

    <VBox spacing="10" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Asignar profesor" styleClass="card-title"/>
                <Label text="Solo aplica para estudiantes de cursos personalizados" styleClass="card-subtitle"/>
            </VBox>
            <Button text="Refrescar" onAction="#onRefrescar" styleClass="btn-secondary"/>
        </HBox>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" maxWidth="180"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
            </columnConstraints>
            <Label text="Estudiante" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbEstudiante" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Curso personalizado" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbCurso" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Profesor" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cmbProfesor" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
        <HBox styleClass="card-actions">
            <Button text="Asignar profesor" onAction="#onAsignar" styleClass="btn-primary"/>
        </HBox>
    </VBox>

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Profesores asignados" styleClass="card-title"/>
        <ListView fx:id="listaAsignaciones" prefHeight="220" VBox.vgrow="ALWAYS" styleClass="list-view"/>
    </VBox>
</VBox>