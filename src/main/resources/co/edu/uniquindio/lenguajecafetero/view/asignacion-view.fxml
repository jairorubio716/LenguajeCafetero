<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.AsignacionController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <HBox spacing="8">
        <Label text="Asignar profesor a curso personalizado"/>
        <Button text="Refrescar" onAction="#onRefrescar"/>
    </HBox>
    <GridPane hgap="8" vgap="8">
        <Label text="Estudiante:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cmbEstudiante" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Curso personalizado:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cmbCurso" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Profesor:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cmbProfesor" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    <Button text="Asignar" onAction="#onAsignar"/>
    <TableView fx:id="tablaAsignaciones" prefHeight="280">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
            <TableColumn fx:id="colEstudiante" text="Estudiante" prefWidth="160"/>
            <TableColumn fx:id="colCurso" text="Curso" prefWidth="180"/>
            <TableColumn fx:id="colProfesor" text="Profesor" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
