<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.AsignacionController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <VBox spacing="10" styleClass="card">
        <HBox spacing="8">
            <Label text="Asignar profesor a curso personalizado"/>
            <Button text="Refrescar" onAction="#onRefrescar" styleClass="btn-primary"/>
        </HBox>
        <GridPane hgap="8" vgap="8">
            <Label text="Estudiante:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbEstudiante" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Curso personalizado:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbCurso" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Profesor:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cmbProfesor" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
        <Button text="Asignar" onAction="#onAsignar" styleClass="btn-primary"/>
    </VBox>
    <ListView fx:id="listaAsignaciones" prefHeight="280" styleClass="list-view"/>
</VBox>
