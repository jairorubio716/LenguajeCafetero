<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="tab-content" spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.EstudianteMatriculasController">

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Mis matrículas" styleClass="card-title"/>
        <Label text="Matrículas a su nombre en la academia" styleClass="card-subtitle"/>
        <ListView fx:id="listaMatriculas" prefHeight="200" VBox.vgrow="ALWAYS" styleClass="list-view"/>
    </VBox>

    <VBox spacing="8" styleClass="card">
        <Label text="Solicitar servicio adicional" styleClass="card-title"/>
        <Label text="El valor del servicio se suma al total de su matrícula" styleClass="card-subtitle"/>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" maxWidth="200"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Matrícula" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbMatricula" maxWidth="1.7976931348623157E308"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Servicio adicional" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbServicio" maxWidth="1.7976931348623157E308"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <VBox alignment="CENTER_RIGHT">
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button text="Refrescar" onAction="#onRefrescar" styleClass="btn-secondary"/>
                <Button text="Solicitar servicio" onAction="#onSolicitar" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>