<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="tab-content" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.lenguajecafetero.controller.EstudiantesController">

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Estudiantes registrados" styleClass="card-title"/>
                <Label text="Los estudiantes crean su propia cuenta desde la pantalla de ingreso" styleClass="card-subtitle"/>
            </VBox>
            <Button text="Refrescar" onAction="#onRefrescar" styleClass="btn-secondary"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" promptText="Buscar estudiante por documento de identidad" HBox.hgrow="ALWAYS"/>
            <Button text="Buscar" onAction="#onBuscar" styleClass="btn-primary"/>
        </HBox>
        <ListView fx:id="listaEstudiantes" prefHeight="240" VBox.vgrow="ALWAYS" styleClass="list-view"/>
        <Label fx:id="lblDetalle" wrapText="true" styleClass="card-subtitle"/>
    </VBox>
</VBox>